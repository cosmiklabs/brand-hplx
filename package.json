{
  "name": "@cosmiklabs/brand-hplx",
  "version": "0.2.0",
  "private": true,
  "description": "The HPLX family of the Cosmik brand: tokens, Glimmer and Spectral, built on a pinned cosmiklabs/brand release.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmiklabs/brand-hplx.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:reproducible": "node scripts/build.mjs --check",
    "build:reference": "node scripts/build-reference.mjs",
    "dev:reference": "npm run build:reference && node scripts/serve-reference.mjs",
    "preview:reference": "node scripts/serve-reference.mjs"
  }
}
